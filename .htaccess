# Delta Engineering Services — canonicalization, security & performance

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force the www host (matches the canonical URLs used in sitemap.xml / meta tags)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to SMTP credential files and PHPMailer internals
<FilesMatch "^(config-credentials|mailCorporate-credentials)\.php$">
	Require all denied
</FilesMatch>
<FilesMatch "\.(log|lock|md)$">
	Require all denied
</FilesMatch>

# Don't let the mailer library folder be browsed
Options -Indexes

# Compress text-based responses
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
	AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Give static assets long-lived cache headers
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
	ExpiresByType text/css "access plus 1 month"
	ExpiresByType application/javascript "access plus 1 month"
	ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Custom 404 that keeps visitors on-site instead of a bare server error page
ErrorDocument 404 /index.php
